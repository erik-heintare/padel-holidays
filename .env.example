# Postgres connection string (Neon in production; local Postgres for development)
DATABASE_URL=postgres://padel:padel@localhost:5432/padel
# Public URL of the site, used for canonical links, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the scout agent sends as `Authorization: Bearer ...` (generate: openssl rand -hex 32)
AGENT_INGEST_TOKEN=
# Password for /admin (HTTP basic auth, any username)
ADMIN_PASSWORD=
# Vercel sets this for cron requests; set it yourself for local testing
CRON_SECRET=
# Optional: email notifications for new enquiries and listing requests
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
